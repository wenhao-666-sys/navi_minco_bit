<?xml version="1.0" encoding="UTF-8"?>
<!-- Scope this profile to the host/Docker serial bridge, not the point-cloud pipeline. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>sentry_serial_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="sentry_serial_bridge" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>sentry_serial_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
